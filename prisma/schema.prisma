generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id                 String   @id @default(cuid())

  listedPrice        Decimal  @db.Decimal(12, 2)

  make               String
  model              String

  year               Int
  miles              Int

  platform           String

  posted             DateTime

  url                String   @unique

  estimatedPrice     Decimal? @db.Decimal(12, 2)
  discountPercentage Decimal? @db.Decimal(5, 2)

  location           String
  zip_code           String

  savedListings SavedListing[]

  createdAt          DateTime @default(now())
}

model SearchConfig {
  id                String @id @default(cuid())

  models            String[]
  makes             String[]

  year_min          Int
  year_max          Int
  max_mileage       Int
  min_mileage       Int
  zip_code          Int
  city              String   @default("Austin")
  radius            Int
  discount_dollar   Int

  discount_thres    Decimal? @db.Decimal(5, 2)

  platforms         String[]
}

model SavedListing {
  id          String @id @default(cuid())

  userId      String
  listingId   String

  status      String

  notes       String?

  createdAt   DateTime @default(now())

  listing   Listing @relation(fields: [listingId], references: [id])
}